# syntax=docker/dockerfile:1.6
FROM node:20-alpine AS base
WORKDIR /work
RUN adduser -D -u 10001 app && corepack enable

FROM base AS deps
ARG SERVICE_NAME
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ packages/ 2>/dev/null || true
COPY services/${SERVICE_NAME}/package.json services/${SERVICE_NAME}/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm fetch --prod --prefer-offline

FROM base AS build
ARG SERVICE_NAME
ENV NODE_ENV=production
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install -r --frozen-lockfile --offline \
 && pnpm --filter ./services/${SERVICE_NAME} build

FROM node:20-alpine AS runner
ENV NODE_ENV=production
USER 10001
WORKDIR /app
ARG SERVICE_NAME
COPY --from=build /work/services/${SERVICE_NAME}/dist ./dist
COPY --from=build /work/services/${SERVICE_NAME}/package.json ./package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    corepack enable && pnpm install --prod --frozen-lockfile --ignore-scripts
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"
CMD ["node","dist/main.js"]
