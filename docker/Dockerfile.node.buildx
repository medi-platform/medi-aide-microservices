# syntax=docker/dockerfile:1.6
# Optimized Node.js Dockerfile for Buildx with external HDD
FROM node:20-alpine AS base
WORKDIR /work
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

FROM base AS deps
ARG SERVICE_NAME
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ packages/ 2>/dev/null || true
COPY services/${SERVICE_NAME}/package.json services/${SERVICE_NAME}/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm config set registry https://registry.npmjs.org/ && \
    pnpm fetch --prod

FROM base AS build
ARG SERVICE_NAME
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install -r --frozen-lockfile && \
    pnpm -r --filter './packages/**' build && \
    pnpm --filter ./services/${SERVICE_NAME} build

FROM node:20-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
ARG SERVICE_NAME

# Copy built application
COPY --from=build /work/services/${SERVICE_NAME}/dist ./dist
COPY --from=build /work/services/${SERVICE_NAME}/package.json ./package.json
COPY --from=build /work/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build /work/pnpm-workspace.yaml ./pnpm-workspace.yaml

# Install production dependencies only
RUN corepack enable && \
    corepack prepare pnpm@8.15.0 --activate && \
    pnpm config set registry https://registry.npmjs.org/ && \
    pnpm install --prod --frozen-lockfile --ignore-scripts

# Create non-root user without recursive chown
RUN addgroup -g 10001 app && \
    adduser -u 10001 -G app -s /bin/sh -D app && \
    chown 10001:10001 /app

USER 10001

EXPOSE 3000

# Simple health check
HEALTHCHECK --interval=30s --timeout=3s \
    CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
