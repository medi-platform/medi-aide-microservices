# Simple production Dockerfile for pnpm monorepo services
FROM node:20-alpine AS builder

ARG SERVICE_NAME

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /app

# Copy everything
COPY . .

# Install all dependencies and build
RUN pnpm install --frozen-lockfile && \
    pnpm -r --filter './packages/**' build && \
    pnpm --filter @medi-aide/${SERVICE_NAME} build

# Production stage
FROM node:20-alpine

ARG SERVICE_NAME
ENV NODE_ENV=production

WORKDIR /app

# Copy the built service and its node_modules
COPY --from=builder /app/services/${SERVICE_NAME}/dist ./dist
COPY --from=builder /app/services/${SERVICE_NAME}/node_modules ./node_modules
COPY --from=builder /app/services/${SERVICE_NAME}/package.json ./package.json

# Non-root user
RUN addgroup -g 10001 app && \
    adduser -u 10001 -G app -s /bin/sh -D app && \
    chown 10001:10001 /app

USER 10001

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s \
    CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
