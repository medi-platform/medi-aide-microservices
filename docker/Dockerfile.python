# syntax=docker/dockerfile:1.6
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /work

FROM base AS deps
ARG SERVICE_NAME
COPY services/${SERVICE_NAME}/pyproject.toml services/${SERVICE_NAME}/poetry.lock* /work/services/${SERVICE_NAME}/ 2>/dev/null || true
COPY services/${SERVICE_NAME}/requirements*.txt /work/services/${SERVICE_NAME}/ 2>/dev/null || true
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"
RUN --mount=type=cache,target=/root/.cache/pip \
    bash -lc 'if [ -f services/${SERVICE_NAME}/requirements.txt ]; then pip wheel -r services/${SERVICE_NAME}/requirements.txt -w /wheels; fi'

FROM base AS runner
ENV PATH="/venv/bin:$PATH"
WORKDIR /app
ARG SERVICE_NAME
COPY --from=deps /venv /venv
COPY services/${SERVICE_NAME}/ /app/
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD python - <<'PY' || exit 1
import urllib.request, sys
try:
  with urllib.request.urlopen("http://127.0.0.1:3000/health", timeout=3) as r:
    sys.exit(0 if r.status==200 else 1)
except Exception:
  sys.exit(1)
PY
CMD ["python", "main.py"]
