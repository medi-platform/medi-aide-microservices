{
  "annotations": { "list": [] },
  "description": "EVV Service - Electronic Visit Verification Compliance Dashboard",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Compliance Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 98 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "(sum(rate(evv_verification_success_total[24h])) / sum(rate(evv_verification_total[24h]))) * 100",
          "legendFormat": "Verification Rate",
          "refId": "A"
        }
      ],
      "title": "EVV Verification Rate",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(increase(evv_missing_clockin_total[24h]))",
          "legendFormat": "Missing Clock-ins",
          "refId": "A"
        }
      ],
      "title": "Missing Clock-ins (24h)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(increase(evv_visits_completed_total[24h]))",
          "legendFormat": "Completed Visits",
          "refId": "A"
        }
      ],
      "title": "Visits Completed (24h)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(increase(evv_location_fraud_detected_total[24h]))",
          "legendFormat": "Fraud Alerts",
          "refId": "A"
        }
      ],
      "title": "Location Fraud Alerts (24h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 6,
      "panels": [],
      "title": "Clock-in/Clock-out Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(evv_clockin_total[5m])) by (status)",
          "legendFormat": "Clock-in ({{ status }})",
          "refId": "A"
        },
        {
          "expr": "sum(rate(evv_clockout_total[5m])) by (status)",
          "legendFormat": "Clock-out ({{ status }})",
          "refId": "B"
        }
      ],
      "title": "Clock-in/Clock-out Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "unit": "m" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(evv_location_accuracy_meters_bucket[5m])) by (le))",
          "legendFormat": "p50 Accuracy",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(evv_location_accuracy_meters_bucket[5m])) by (le))",
          "legendFormat": "p95 Accuracy",
          "refId": "B"
        }
      ],
      "title": "GPS Accuracy Distribution",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "panels": [],
      "title": "Visit Duration",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "unit": "m" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(evv_visit_duration_minutes_bucket[5m])) by (le, service_type))",
          "legendFormat": "{{ service_type }} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(evv_visit_duration_minutes_bucket[5m])) by (le, service_type))",
          "legendFormat": "{{ service_type }} p95",
          "refId": "B"
        }
      ],
      "title": "Visit Duration by Service Type",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["medi-aide", "evv", "compliance"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "EVV Compliance Dashboard",
  "uid": "evv-compliance",
  "version": 1
}

