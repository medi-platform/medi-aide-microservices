{
  "name": "medi-aide-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Medi-Aide Stage 3 Monorepo with Package-Based Composition",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "lint": "pnpm run -r lint",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "start:monolith": "concurrently \"pnpm --filter medi-aide-backend dev\" \"pnpm --filter medi-aide-frontend dev\"",
    "start:stage3": "./scripts/dev-parallel.sh",
    "build:packages": "pnpm --filter './packages/**' build",
    "build:services": "pnpm --filter './services/**' build"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "concurrently": "^8.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@nestjs/terminus": "^10.0.0"
  }
}