networks:
  stage3-network:
    external: true
    name: stage3-network

services:
  notification-service:
    build:
      context: ./services/notification-service
      dockerfile: Dockerfile
    container_name: stage3-notification-service
    environment:
      - NODE_ENV=development
      - PORT=4010
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - RABBITMQ_URL=amqp://admin:admin@stage3-rabbitmq:5672
      - ENABLE_SERVICE_DISCOVERY=false
    ports:
      - "4010:4010"
      - "50051:50051"
    depends_on:
      - stage3-postgres
      - stage3-rabbitmq
    networks:
      - stage3-network

  auth-service:
    build:
      context: ./services/auth-service
    container_name: stage3-auth-service
    environment:
      - NODE_ENV=development
      - PORT=4011
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_DATABASE=auth_db
      - JWT_SECRET=dev-secret
    ports:
      - "4011:4011"
    depends_on:
      - stage3-postgres
    networks:
      - stage3-network

  user-service:
    build:
      context: ./services/user-service
    container_name: stage3-user-service
    environment:
      - NODE_ENV=development
      - PORT=4012
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_DATABASE=user_db
    ports:
      - "4012:4012"
    depends_on:
      - stage3-postgres
    networks:
      - stage3-network

  visit-service:
    build:
      context: ./services/visit-service
    container_name: stage3-visit-service
    environment:
      - NODE_ENV=development
      - PORT=4013
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_DATABASE=visit_db
    ports:
      - "4013:4013"
    depends_on:
      - stage3-postgres
    networks:
      - stage3-network

  wellness-service:
    build:
      context: ./services/wellness-service
    container_name: stage3-wellness-service
    environment:
      - NODE_ENV=development
      - PORT=4014
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_DATABASE=wellness_db
    ports:
      - "4014:4014"
    depends_on:
      - stage3-postgres
    networks:
      - stage3-network

  payment-service:
    build:
      context: ./services/payment-service
    container_name: stage3-payment-service
    environment:
      - NODE_ENV=development
      - PORT=4015
      - DB_HOST=stage3-postgres
      - DB_PORT=5432
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_DATABASE=payment_db
    ports:
      - "4015:4015"
    depends_on:
      - stage3-postgres
    networks:
      - stage3-network


