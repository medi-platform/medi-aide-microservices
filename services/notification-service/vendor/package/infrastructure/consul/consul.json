{
  "datacenter": "dc1",
  "data_dir": "/consul/data",
  "log_level": "INFO",
  "node_name": "consul-server",
  "server": true,
  "bootstrap_expect": 1,
  "ui_config": {
    "enabled": true
  },
  "connect": {
    "enabled": true
  },
  "ports": {
    "grpc": 8502
  },
  "client_addr": "0.0.0.0",
  "bind_addr": "0.0.0.0",
  "advertise_addr": "{{ GetPrivateInterfaces | include \"network\" \"172.0.0.0/8\" | attr \"address\" }}",
  "services": {
    "consul": {
      "name": "consul",
      "tags": ["infrastructure", "service-discovery"],
      "port": 8500,
      "check": {
        "http": "http://localhost:8500/v1/status/leader",
        "interval": "10s"
      }
    }
  },
  "watches": [
    {
      "type": "services",
      "handler_type": "script",
      "args": ["/consul/scripts/service-watcher.sh"]
    }
  ],
  "telemetry": {
    "prometheus_retention_time": "60s",
    "disable_hostname": true
  },
  "performance": {
    "raft_multiplier": 1
  }
}
